#!/usr/bin/env python3
"""Read calendars, answer one question: what is about to start?

Standard library only, on purpose. Mokuzen runs inside the Omarchy shell
process on someone else's machine; every dependency it does not have is one
less thing that can be missing, stale, or surprising at 9:59am.

Commands:
    check     print the next occurrence inside the lead window, as JSON
    list      print upcoming occurrences, as JSON (for eyeballing a setup)
    refresh   refetch every remote calendar into the cache
    doctor    report what is configured, reachable, and parseable
    setup     write the configuration file: add a calendar, set the lead time
"""

from __future__ import annotations

import argparse
import calendar as _calendar
import hashlib
import http.client
import ipaddress
import json
import os
import re
import signal
import socket
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import date, datetime, time as dtime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlsplit

try:
    from zoneinfo import ZoneInfo
except ImportError:  # pragma: no cover - Python < 3.9
    ZoneInfo = None

USER_AGENT = "mokuzen/1.0 (+https://github.com/dedeanth/omarchy-mokuzen)"
NETWORK_TIMEOUT = 8
# Shared across every remote calendar fetched within one command invocation
# (see collect()), not per-URL - five slow calendars must not add up to five
# times this budget, since the QML side kills the whole process on a single
# fixed deadline regardless of how many calendars are configured.
FETCH_TOTAL_DEADLINE = 15
# `setup` explicitly re-verifies every calendar in turn, which legitimately
# takes longer than a background poll; it gets its own, longer shared budget.
SETUP_VERIFY_DEADLINE = 45

DEFAULTS = {
    "calendars": [],
    "leadSeconds": 60,
    "pollSeconds": 30,
    "refreshSeconds": 300,
    "lookaheadDays": 30,
    "snoozeSeconds": 60,
    "graceSeconds": 120,
    "autoDismissSeconds": 0,
    "ignoreAllDay": True,
    "skipCancelled": True,
    "skipDeclined": True,
    "selfEmails": [],
    "ignoreTitles": [],
    "onlyWithLink": False,
    "enabled": True,
}

# Every cap below exists because a calendar is not trusted input: it can be a
# malicious feed, a compromised account, or just a broken export. None of
# these numbers are meant to be exact; they are meant to turn "unbounded"
# into "large enough for a real calendar, too small to hurt anything."
MAX_CONFIG_BYTES = 1 * 1024 * 1024
MAX_CACHE_BYTES = 16 * 1024 * 1024
MAX_ICS_FILE_BYTES = 8 * 1024 * 1024
MAX_ICS_FILES_PER_SOURCE = 200
MAX_REMOTE_BYTES = 10 * 1024 * 1024

MAX_ICS_LINES = 200_000
MAX_ICS_LINE_CHARS = 20_000
MAX_LINES_PER_EVENT = 2_000
# The file's own poll-cache comment below cites a real 6 MB / ten-thousand
# event export as unremarkable; this cap exists for hostility, not to second-
# guess a real calendar, so it sits well above that.
MAX_EVENTS_PER_DOCUMENT = 20_000
MAX_FIELD_CHARS = 2_000
MAX_UID_CHARS = 512
MAX_DESCRIPTION_CHARS = 20_000
MAX_EXDATES_PER_EVENT = 500
MAX_RULE_TOKENS = 366
MAX_RRULE_COUNT = 10_000
MAX_RRULE_INTERVAL = 10_000
# _fast_forward_count_anchor now skips the "dead zone" between an old
# DTSTART and the current window arithmetically for the common rule shapes,
# so this only bounds the day-by-day walk for what's left: rare COUNT rules
# that also combine BYDAY/BYMONTHDAY/BYMONTH, plus the ordinary (non-COUNT)
# window-sized walk every rule does. The wall-clock ceiling below is the
# real DoS backstop either way; the step count alone is not trusted to bound
# cost (see byday_matches's per-day cache, which is what keeps each step
# cheap enough for that to be true).
MAX_EXPAND_STEPS = 20_000
MAX_EXPAND_SECONDS = 0.3
# Across one occurrences() call: many maximally-expensive events must not add
# up to more than this, regardless of how many the document cap allows.
MAX_TOTAL_EXPAND_SECONDS = 3.0
MAX_ICS_DIR_TOTAL_BYTES = 32 * 1024 * 1024
MAX_DIR_ENTRIES_PER_LEVEL = 5_000
MAX_DIRS_VISITED = 20_000
MAX_WARNINGS = 50
MAX_CALENDAR_SOURCES = 32
MAX_SOURCE_CHARS = 4_096
MAX_TOTAL_DOCUMENTS = 256
MAX_TOTAL_ICS_BYTES = 64 * 1024 * 1024
MAX_TOTAL_EVENTS = 50_000
MAX_OCCURRENCES = 5_000
MAX_OCCURRENCE_PAYLOAD_BYTES = 8 * 1024 * 1024
MAX_LINK_CHARS = 2_000
MAX_WARNING_CHARS = 5_000
MAX_IGNORE_TITLES = 32
MAX_IGNORE_PATTERN_CHARS = 256
MAX_SELF_EMAILS = 64
MAX_EMAIL_CHARS = 320
MAX_REGEX_INPUT_CHARS = 2_000
MAX_REGEX_SECONDS = 0.02


# --------------------------------------------------------------------------
# configuration


def config_path(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit).expanduser()
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return Path(base) / "omarchy" / "mokuzen.json"


def _bounded_string_list(value, name: str, count: int, chars: int) -> list[str]:
    if isinstance(value, str) and name == "calendars":
        value = [value]
    if not isinstance(value, list):
        raise ValueError(f"{name} must be a JSON array")
    if len(value) > count:
        raise ValueError(f"{name} contains more than {count} entries")
    result: list[str] = []
    for item in value:
        if not isinstance(item, str):
            raise ValueError(f"every {name} entry must be a string")
        if not item or len(item) > chars:
            raise ValueError(f"every {name} entry must contain 1..{chars} characters")
        result.append(item)
    return result


def _validate_config(loaded: dict, path: Path) -> dict:
    cfg = dict(DEFAULTS)
    cfg.update(loaded)

    cfg["calendars"] = _bounded_string_list(
        cfg.get("calendars", []), "calendars", MAX_CALENDAR_SOURCES, MAX_SOURCE_CHARS
    )
    for source in cfg["calendars"]:
        lower = source.lower()
        if lower.startswith("http://"):
            raise ValueError("remote calendar URLs must use https:// or webcal://")
        if lower.startswith(("https://", "webcal://")):
            parsed = urlsplit(normalize_url(source))
            try:
                parsed_port = parsed.port
            except ValueError:
                raise ValueError("remote calendar URL has an invalid port")
            if (
                not parsed.hostname
                or parsed.username is not None
                or parsed.password is not None
                or parsed_port is not None and not 1 <= parsed_port <= 65_535
            ):
                raise ValueError("remote calendar URL is malformed or contains user-info")
    cfg["ignoreTitles"] = _bounded_string_list(
        cfg.get("ignoreTitles", []), "ignoreTitles", MAX_IGNORE_TITLES,
        MAX_IGNORE_PATTERN_CHARS,
    )
    cfg["selfEmails"] = _bounded_string_list(
        cfg.get("selfEmails", []), "selfEmails", MAX_SELF_EMAILS, MAX_EMAIL_CHARS
    )

    for key in ("ignoreAllDay", "skipCancelled", "skipDeclined", "onlyWithLink", "enabled"):
        if not isinstance(cfg.get(key), bool):
            raise ValueError(f"{key} must be true or false")

    ranges = {
        "leadSeconds": (0, 86_400),
        "pollSeconds": (10, 86_400),
        "refreshSeconds": (30, 86_400),
        "lookaheadDays": (1, 366),
        "snoozeSeconds": (30, 604_800),
        "graceSeconds": (0, 86_400),
        "autoDismissSeconds": (0, 86_400),
    }
    for key, (minimum, maximum) in ranges.items():
        value = cfg.get(key)
        if isinstance(value, bool) or not isinstance(value, int):
            raise ValueError(f"{key} must be an integer")
        if not minimum <= value <= maximum:
            raise ValueError(f"{key} must be between {minimum} and {maximum}")

    cfg["_path"] = str(path)
    cfg["_exists"] = path.exists()
    return cfg


def load_config(explicit: str | None) -> dict:
    path = config_path(explicit)
    loaded: dict = {}
    if path.exists():
        try:
            loaded = json.loads(_read_capped_no_follow(path, MAX_CONFIG_BYTES))
        except (OSError, ValueError) as exc:
            raise SystemExit(f"mokuzen: cannot read {path}: {exc}")
        if not isinstance(loaded, dict):
            raise SystemExit(f"mokuzen: {path} must contain a JSON object")
    try:
        return _validate_config(loaded, path)
    except ValueError as exc:
        raise SystemExit(f"mokuzen: invalid configuration in {path}: {exc}")


def cache_dir() -> Path:
    # The cache holds the calendar itself — every title, every attendee. It
    # is exactly as private as the address that fetched it, so it goes
    # through the same owner-only, no-follow validation as every write below
    # (_owner_dir_fd), not just a plain chmod — this directory is entirely
    # ours, unlike mokuzen.json's parent, so unlike there this always
    # tightens its mode.
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    path = Path(base) / "mokuzen"
    fd = _owner_dir_fd(path)
    try:
        try:
            os.fchmod(fd, 0o700)
        except OSError:
            pass
    finally:
        os.close(fd)
    return path


# --------------------------------------------------------------------------
# filesystem safety
#
# Every write below goes through a directory descriptor opened with
# O_NOFOLLOW and checked for ownership, so a symlink pre-planted at a parent
# or leaf name cannot redirect the write to somewhere it does not belong.
# Every read of untrusted-size data goes through a byte cap and O_NOFOLLOW on
# the leaf, so a hostile or looping filesystem cannot turn a read into an
# unbounded one.


def _owner_dir_fd(path: Path) -> int:
    """Open path as a directory descriptor, refusing a symlinked leaf (via
    O_NOFOLLOW — open fails with ELOOP before we ever see it) or one owned by
    someone else. Existing directories are never chmodded here:
    mokuzen.json's parent is the rest of the user's Omarchy configuration,
    not ours. cache_dir(), which owns its directory, tightens that mode
    explicitly after this check."""
    flags = os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(path), flags)
    except FileNotFoundError:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
        try:
            fd = os.open(str(path), flags)
        except OSError as exc:
            raise SystemExit(f"mokuzen: refusing to use {path}: {exc}")
    except OSError as exc:
        raise SystemExit(f"mokuzen: refusing to use {path}: {exc}")
    try:
        st = os.fstat(fd)
        if st.st_uid != os.getuid():
            raise SystemExit(f"mokuzen: refusing to use {path}: not an owner-only directory")
    except BaseException:
        os.close(fd)
        raise
    return fd


def write_private(path: Path, text: str) -> None:
    """Write owner-only, atomically: a random same-directory temp name under
    O_EXCL|O_NOFOLLOW, fsynced before an atomic rename — all through the
    directory's own descriptor."""
    dir_fd = _owner_dir_fd(path.parent)
    try:
        tmp_name = f".{path.name}.{os.urandom(8).hex()}.part"
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0)
        fd = os.open(tmp_name, flags, 0o600, dir_fd=dir_fd)
        try:
            with os.fdopen(fd, "wb") as handle:
                handle.write(text.encode("utf-8"))
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(tmp_name, path.name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
        except BaseException:
            try:
                os.unlink(tmp_name, dir_fd=dir_fd)
            except OSError:
                pass
            raise
        try:
            os.fsync(dir_fd)
        except OSError:
            pass
    finally:
        os.close(dir_fd)


def _read_capped_no_follow(path: Path, max_bytes: int) -> str:
    """Read a regular file through a byte cap without following its leaf."""
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(str(path), flags)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"{path} is not a regular file")
        if st.st_size > max_bytes:
            raise OSError(f"{path} exceeds {max_bytes} bytes, refusing to read")
    except BaseException:
        os.close(fd)
        raise
    with os.fdopen(fd, "rb") as handle:
        data = handle.read(max_bytes + 1)
    if len(data) > max_bytes:
        raise OSError(f"{path} exceeds {max_bytes} bytes, refusing to read")
    return data.decode("utf-8", errors="replace")


def _iter_ics_files(root: Path, limit: int) -> list[Path]:
    """Enumerate .ics files under root without following symlinks — so a
    configured directory cannot be pointed outside itself or looped back on
    itself — and capped so a directory bomb cannot make this run forever.
    Each directory level is read through a bounded iterator, so a single
    directory with millions of entries cannot be fully materialized before
    the cap has a chance to apply. The stack itself is also capped: finding
    at most MAX_ICS_FILES_PER_SOURCE .ics files does not by itself bound how
    many *empty* subdirectories get visited on the way, so that is bounded
    separately here."""
    found: list[Path] = []
    stack = [root]
    visited_dirs = 0
    while stack and len(found) < limit and visited_dirs < MAX_DIRS_VISITED:
        current = stack.pop()
        visited_dirs += 1
        entries = []
        try:
            with os.scandir(current) as it:
                for entry in it:
                    entries.append(entry)
                    if len(entries) >= MAX_DIR_ENTRIES_PER_LEVEL:
                        break
        except OSError:
            continue
        entries.sort(key=lambda e: e.name)
        for entry in entries:
            if entry.is_symlink():
                continue
            if entry.is_dir(follow_symlinks=False):
                # Bound pending work, not just directories already visited —
                # otherwise one level with thousands of subdirectories could
                # queue far more than MAX_DIRS_VISITED will ever get to pop.
                if len(stack) < MAX_DIRS_VISITED:
                    stack.append(Path(entry.path))
            elif entry.is_file(follow_symlinks=False) and entry.name.endswith(".ics"):
                found.append(Path(entry.path))
                if len(found) >= limit:
                    break
    return sorted(found)[:limit]


# --------------------------------------------------------------------------
# fetching


def mask(source: str) -> str:
    """A secret iCal address is a credential: anyone holding it reads the
    calendar. Never echo one back in full."""
    if not is_remote(source):
        return source
    parsed = urlsplit(normalize_url(source))
    if not parsed.hostname:
        return "<remote calendar>"
    # Even a short path suffix can be useful credential material. The host is
    # enough to identify the provider without leaking any secret URL token.
    host = parsed.hostname
    if ":" in host:
        host = f"[{host}]"
    try:
        if parsed.port is not None:
            host = f"{host}:{parsed.port}"
    except ValueError:
        return "<remote calendar>"
    return f"https://{host}/<redacted>"


def is_remote(source: str) -> bool:
    return source.lower().startswith(("http://", "https://", "webcal://"))


def normalize_url(source: str) -> str:
    if source.lower().startswith("webcal://"):
        return "https://" + source[len("webcal://"):]
    return source


def cache_file(source: str) -> Path:
    digest = hashlib.sha256(source.encode("utf-8")).hexdigest()[:16]
    return cache_dir() / f"{digest}.ics"


class _FetchTooLarge(Exception):
    pass


class _FetchTimedOut(Exception):
    pass


def _public_addresses(hostname: str | None, port: int) -> list[str] | None:
    """Resolve once and return only addresses safe to connect to.

    None means DNS failed. An empty list means the host resolved, but at
    least one answer was non-public; mixed public/private answers are rejected
    too. The returned addresses are passed directly to the socket connection,
    so validation and use cannot be separated by a DNS-rebinding race.
    """
    if not hostname:
        return None
    try:
        infos = socket.getaddrinfo(hostname, port, type=socket.SOCK_STREAM)
    except OSError:
        return None
    if not infos:
        return None
    addresses: list[str] = []
    for info in infos:
        raw = info[4][0].split("%")[0]
        try:
            addr = ipaddress.ip_address(raw)
        except ValueError:
            return []
        if (
            addr.is_private or addr.is_loopback or addr.is_link_local
            or addr.is_multicast or addr.is_reserved or addr.is_unspecified
        ):
            return []
        if raw not in addresses:
            addresses.append(raw)
    return addresses


def _is_public_host(hostname: str | None) -> bool | None:
    """Compatibility helper used by diagnostics and tests."""
    addresses = _public_addresses(hostname, 443)
    return None if addresses is None else bool(addresses)


class _PinnedHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS connection whose socket uses addresses already policy-checked.

    The HTTP Host header and TLS SNI still use the original hostname, while
    the TCP socket connects to a validated numeric address. This closes the
    validate-one-DNS-answer/connect-to-another rebinding window.
    """

    def __init__(self, host, *, pinned_addresses: list[str], **kwargs):
        self._pinned_addresses = pinned_addresses
        super().__init__(host, **kwargs)

    def connect(self):
        last_error: OSError | None = None
        for address in self._pinned_addresses:
            sock = None
            try:
                sock = socket.create_connection(
                    (address, self.port), self.timeout, self.source_address
                )
                if self._tunnel_host:
                    self.sock = sock
                    self._tunnel()
                server_hostname = self._tunnel_host or self.host
                self.sock = self._context.wrap_socket(sock, server_hostname=server_hostname)
                return
            except OSError as exc:
                if sock is not None:
                    try:
                        sock.close()
                    except OSError:
                        pass
                self.sock = None
                last_error = exc
        if last_error is not None:
            raise last_error
        raise OSError("calendar host has no usable public address")


class _PinnedHTTPSHandler(urllib.request.HTTPSHandler):
    def https_open(self, req):
        parsed = urlsplit(req.full_url)
        if parsed.username is not None or parsed.password is not None:
            raise urllib.error.URLError("calendar URL user-info is not supported")
        port = parsed.port or 443
        addresses = _public_addresses(parsed.hostname, port)
        if addresses is None:
            raise urllib.error.URLError("could not resolve calendar host")
        if not addresses:
            raise urllib.error.URLError("calendar host resolves to a private/internal address")

        def connection(host, **kwargs):
            return _PinnedHTTPSConnection(host, pinned_addresses=addresses, **kwargs)

        return self.do_open(connection, req, context=self._context)


class _HttpsOnlyRedirectHandler(urllib.request.HTTPRedirectHandler):
    """A secret iCal address is a credential and a calendar host is not
    trusted infrastructure: neither the first hop nor any redirect it sends
    us on may downgrade to plain http, or point at a private/internal host.

    Every destination is checked here and again by the pinned HTTPS handler
    that actually connects. The parent process imposes the wall-clock limit
    over the whole worker, including DNS and all redirects; the small hop cap
    is an additional bound. Real calendar redirects are 0-1 hops in practice.
    """

    max_redirections = 3

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.lower().startswith("https://"):
            raise urllib.error.URLError("refused redirect to a non-https URL")
        parsed = urlsplit(newurl)
        if parsed.username is not None or parsed.password is not None:
            raise urllib.error.URLError("refused redirect containing URL user-info")
        addresses = _public_addresses(parsed.hostname, parsed.port or 443)
        if not addresses:
            raise urllib.error.URLError("refused redirect: private/internal host, or DNS failure")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _read_capped_response(response, max_bytes: int, deadline: float) -> bytes:
    chunks = []
    total = 0
    while True:
        if time.monotonic() > deadline:
            raise _FetchTimedOut("fetch exceeded its overall deadline")
        chunk = response.read(65536)
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            raise _FetchTooLarge(f"calendar exceeds {max_bytes} bytes")
        chunks.append(chunk)
    return b"".join(chunks)


def _network_fetch(url: str, budget_seconds: float) -> bytes:
    """Perform one complete network fetch inside the disposable worker."""
    parsed = urlsplit(url)
    if (
        parsed.scheme.lower() != "https"
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
    ):
        raise ValueError("calendar URL must be an HTTPS URL without user-info")
    deadline = time.monotonic() + max(0.001, budget_seconds)
    # Environment proxies would resolve/connect on our behalf, defeating the
    # pinned-address SSRF check. Calendar fetches therefore connect directly.
    opener = urllib.request.build_opener(
        urllib.request.ProxyHandler({}),
        _HttpsOnlyRedirectHandler(),
        _PinnedHTTPSHandler(),
    )
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with opener.open(request, timeout=NETWORK_TIMEOUT) as response:
        if not response.geturl().lower().startswith("https://"):
            raise urllib.error.URLError("final URL is not https://")
        return _read_capped_response(response, MAX_REMOTE_BYTES, deadline)


def _fetch_worker_main(argv: list[str]) -> int:
    """Private subprocess entry point. The URL arrives on stdin so a secret
    calendar credential never appears in the process list."""
    try:
        budget = min(FETCH_TOTAL_DEADLINE, max(0.001, float(argv[0])))
        raw_url = sys.stdin.buffer.read(MAX_SOURCE_CHARS + 1)
        if len(raw_url) > MAX_SOURCE_CHARS:
            raise ValueError("calendar URL is too long")
        url = raw_url.decode("utf-8", errors="strict")
        if not url.lower().startswith("https://"):
            raise ValueError("calendar URL is not https")
        payload = _network_fetch(url, budget)
        sys.stdout.buffer.write(payload)
        return 0
    except _FetchTooLarge as exc:
        sys.stderr.write(str(exc)[:1_000])
        return 1
    except _FetchTimedOut as exc:
        sys.stderr.write(str(exc)[:1_000])
        return 1
    except urllib.error.HTTPError as exc:
        # HTTPError carries the complete request URL as an attribute. Emit
        # only the status, never str/repr of objects that may contain the
        # credential-bearing path.
        sys.stderr.write(f"calendar server returned HTTP {exc.code}")
        return 1
    except Exception:
        # Network, TLS and redirect exceptions are deliberately generic here:
        # some urllib exceptions embed the complete request URL.
        sys.stderr.write("calendar network request failed")
        return 1


def _fetch_in_subprocess(url: str, deadline: float) -> bytes:
    """Fetch behind a killable process boundary.

    CPython cannot impose a timeout on libc getaddrinfo(). Keeping DNS,
    redirect handling, TLS and response reads in this child lets the parent
    enforce one actual wall-clock deadline over all of them.
    """
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise _FetchTimedOut("fetch exceeded its overall deadline")
    env = os.environ.copy()
    env["MOKUZEN_FETCH_WORKER"] = "1"
    worker = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), "_fetch-worker", f"{remaining:.3f}"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        env=env,
    )
    try:
        remaining = max(0.001, deadline - time.monotonic())
        output, error = worker.communicate(url.encode("utf-8"), timeout=remaining)
    except subprocess.TimeoutExpired:
        worker.kill()
        worker.communicate()
        raise _FetchTimedOut("fetch exceeded its overall deadline")
    if len(output) > MAX_REMOTE_BYTES:
        raise _FetchTooLarge(f"calendar exceeds {MAX_REMOTE_BYTES} bytes")
    if worker.returncode != 0:
        message = error.decode("utf-8", errors="replace")[:1_000] or "fetch worker failed"
        raise urllib.error.URLError(message)
    return output


def fetch_remote(
    source: str, max_age: int, force: bool = False, shared_deadline: float | None = None
) -> tuple[str, str | None]:
    """Return (text, warning). Stale cache beats no calendar at all.

    shared_deadline, when given, is a time.monotonic() ceiling this call must
    not push past — used by collect() to bound the total time one command
    invocation spends on all of its remote calendars combined, not just this
    one."""
    target = cache_file(source)
    fresh_enough = False
    if target.exists() and not force:
        age = max(0.0, datetime.now().timestamp() - target.stat().st_mtime)
        fresh_enough = age < max(0, max_age)
    if fresh_enough:
        try:
            return _read_capped_no_follow(target, MAX_REMOTE_BYTES), None
        except OSError:
            pass

    normalized = normalize_url(source)
    if not normalized.lower().startswith("https://"):
        label = mask(source)
        return "", f"{label}: only https:// and webcal:// calendars are supported"

    if shared_deadline is not None and time.monotonic() > shared_deadline:
        label = mask(source)
        if target.exists():
            try:
                stale = _read_capped_no_follow(target, MAX_REMOTE_BYTES)
                return stale, f"{label}: skipped (this run's calendar time budget is spent); using cached copy"
            except OSError:
                pass
        return "", f"{label}: skipped (this run's calendar time budget is spent)"

    deadline = time.monotonic() + FETCH_TOTAL_DEADLINE
    if shared_deadline is not None:
        deadline = min(deadline, shared_deadline)
    try:
        raw = _fetch_in_subprocess(normalized, deadline)
        text = raw.decode("utf-8", errors="replace")
        if len(text.encode("utf-8")) > MAX_REMOTE_BYTES:
            raise _FetchTooLarge("decoded calendar exceeds the cache byte cap")
        write_private(target, text)
        return text, None
    except (urllib.error.URLError, OSError, ValueError, _FetchTooLarge, _FetchTimedOut) as exc:
        # Never echo the address itself: a secret iCal URL in a log line or a
        # pasted bug report is the whole calendar handed over.
        label = mask(source)
        if target.exists():
            try:
                stale = _read_capped_no_follow(target, MAX_REMOTE_BYTES)
                return stale, f"{label}: unreachable ({exc}); using cached copy"
            except OSError:
                pass
        return "", f"{label}: unreachable ({exc})"


def read_source(
    source: str, max_age: int, force: bool = False, shared_deadline: float | None = None
) -> tuple[list[str], list[str]]:
    """Return (list of ICS documents, warnings)."""
    if is_remote(source):
        text, warning = fetch_remote(source, max_age, force, shared_deadline)
        return ([text] if text else []), ([warning] if warning else [])

    path = Path(source).expanduser()
    if path.is_symlink():
        return [], [f"{path}: symlinked calendar sources are not followed"]
    if path.is_dir():
        documents, warnings = [], []
        total_bytes = 0
        for child in _iter_ics_files(path, MAX_ICS_FILES_PER_SOURCE):
            if total_bytes >= MAX_ICS_DIR_TOTAL_BYTES:
                warnings.append(
                    f"{path}: reached the {MAX_ICS_DIR_TOTAL_BYTES}-byte budget for this "
                    "directory, remaining files were skipped"
                )
                break
            try:
                text = _read_capped_no_follow(child, MAX_ICS_FILE_BYTES)
            except OSError as exc:
                warnings.append(f"{child}: {exc}")
                continue
            total_bytes += len(text.encode("utf-8"))
            documents.append(text)
        return documents, warnings
    if path.is_file():
        try:
            return [_read_capped_no_follow(path, MAX_ICS_FILE_BYTES)], []
        except OSError as exc:
            return [], [f"{path}: {exc}"]
    return [], [f"{source}: no such file or directory"]


# --------------------------------------------------------------------------
# iCalendar parsing
#
# Every limit here treats the parsed document as hostile: a feed can carry
# unlimited lines, events, or field lengths, and a single malformed rule must
# not be able to take the rest of the calendar down with it.


def unfold(text: str) -> list[str]:
    lines: list[str] = []
    for raw in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if len(raw) > MAX_ICS_LINE_CHARS:
            raw = raw[:MAX_ICS_LINE_CHARS]
        if raw[:1] in (" ", "\t") and lines:
            if len(lines[-1]) < MAX_ICS_LINE_CHARS:
                lines[-1] += raw[1:]
        else:
            if len(lines) >= MAX_ICS_LINES:
                break
            lines.append(raw)
    return lines


def parse_line(line: str) -> tuple[str, dict, str] | None:
    if not line or ":" not in line:
        return None
    head, value = line.split(":", 1)
    parts = head.split(";")
    name = parts[0].upper()
    params: dict[str, str] = {}
    for chunk in parts[1:]:
        if "=" in chunk:
            key, val = chunk.split("=", 1)
            params[key.upper()] = val.strip('"')
    return name, params, value


def unescape(value: str) -> str:
    out = value.replace("\\n", "\n").replace("\\N", "\n")
    out = out.replace("\\,", ",").replace("\\;", ";")
    return out.replace("\\\\", "\\")


def zone_for(tzid: str | None):
    if not tzid or ZoneInfo is None:
        return None
    try:
        return ZoneInfo(tzid)
    except Exception:
        return None


def local_zone():
    return datetime.now().astimezone().tzinfo


def parse_dt(value: str, params: dict) -> tuple[datetime | date | None, bool]:
    """Return (value, is_all_day). Floating times are read as local."""
    value = value.strip()
    if not value:
        return None, False
    if params.get("VALUE", "").upper() == "DATE" or (len(value) == 8 and "T" not in value):
        try:
            return datetime.strptime(value, "%Y%m%d").date(), True
        except ValueError:
            return None, False
    try:
        if value.endswith("Z"):
            naive = datetime.strptime(value[:-1], "%Y%m%dT%H%M%S")
            return naive.replace(tzinfo=timezone.utc), False
        naive = datetime.strptime(value, "%Y%m%dT%H%M%S")
    except ValueError:
        return None, False
    zone = zone_for(params.get("TZID")) or local_zone()
    return naive.replace(tzinfo=zone), False


def parse_duration(value: str) -> timedelta | None:
    match = re.fullmatch(
        r"([+-])?P(?:(\d+)W)?(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?)?",
        value.strip().upper(),
    )
    if not match:
        return None
    sign = -1 if match.group(1) == "-" else 1
    weeks, days, hours, minutes, seconds = (int(g or 0) for g in match.groups()[1:])
    return sign * timedelta(weeks=weeks, days=days, hours=hours, minutes=minutes, seconds=seconds)


def split_events(text: str) -> tuple[list[list[str]], bool]:
    """Return (events, truncated). `truncated` is only True when a document
    actually had more than MAX_EVENTS_PER_DOCUMENT events — a document with
    exactly that many and no more is not truncated, so callers can warn
    accurately instead of flagging every large-but-untouched calendar."""
    events: list[list[str]] = []
    current: list[str] | None = None
    truncated = False
    for line in unfold(text):
        stripped = line.strip()
        if stripped == "BEGIN:VEVENT":
            if len(events) >= MAX_EVENTS_PER_DOCUMENT:
                truncated = True
                break
            current = []
        elif stripped == "END:VEVENT":
            if current is not None:
                events.append(current)
            current = None
        elif current is not None and len(current) < MAX_LINES_PER_EVENT:
            current.append(line)
    return events, truncated


def parse_event(lines: list[str], calendar_name: str) -> dict | None:
    event: dict = {
        "uid": "",
        "summary": "",
        "location": "",
        "description": "",
        "url": "",
        "status": "",
        "calendar": calendar_name,
        "rrule": "",
        "exdates": [],
        "recurrence_id": None,
        "declined": False,
        "conference": "",
    }
    start = end = None
    all_day = False
    duration = None

    for line in lines:
        parsed = parse_line(line)
        if not parsed:
            continue
        name, params, value = parsed
        if name == "UID":
            event["uid"] = value.strip()[:MAX_UID_CHARS]
        elif name == "SUMMARY":
            event["summary"] = unescape(value).strip()[:MAX_FIELD_CHARS]
        elif name == "LOCATION":
            event["location"] = unescape(value).strip()[:MAX_FIELD_CHARS]
        elif name == "DESCRIPTION":
            event["description"] = unescape(value)[:MAX_DESCRIPTION_CHARS]
        elif name == "URL":
            event["url"] = value.strip()[:MAX_FIELD_CHARS]
        elif name == "STATUS":
            event["status"] = value.strip().upper()[:32]
        elif name == "X-GOOGLE-CONFERENCE":
            event["conference"] = value.strip()[:MAX_FIELD_CHARS]
        elif name == "DTSTART":
            start, all_day = parse_dt(value, params)
        elif name == "DTEND":
            end, _ = parse_dt(value, params)
        elif name == "DURATION":
            duration = parse_duration(value)
        elif name == "RRULE":
            event["rrule"] = value.strip()[:MAX_FIELD_CHARS]
        elif name == "EXDATE":
            if len(event["exdates"]) < MAX_EXDATES_PER_EVENT:
                for chunk in value.split(",")[:MAX_EXDATES_PER_EVENT]:
                    if len(event["exdates"]) >= MAX_EXDATES_PER_EVENT:
                        break
                    excluded, _ = parse_dt(chunk, params)
                    if excluded is not None:
                        event["exdates"].append(excluded)
        elif name == "RECURRENCE-ID":
            recurrence, _ = parse_dt(value, params)
            event["recurrence_id"] = recurrence
        elif name == "ATTENDEE":
            if params.get("PARTSTAT", "").upper() == "DECLINED":
                addresses = event.setdefault("declined_addresses", [])
                if len(addresses) < MAX_EXDATES_PER_EVENT:
                    addresses.append(value.strip().lower()[:MAX_FIELD_CHARS])

    if start is None or not event["uid"]:
        return None

    if end is None:
        if duration is not None:
            end = start + duration
        elif all_day:
            end = start + timedelta(days=1)
        else:
            end = start + timedelta(hours=1)

    event["start"] = start
    event["end"] = end
    event["all_day"] = all_day
    return event


# --------------------------------------------------------------------------
# recurrence


WEEKDAYS = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}


def parse_rrule(rule: str) -> dict:
    chunks = rule.split(";")
    if not chunks or len(chunks) > MAX_RULE_TOKENS:
        raise ValueError("RRULE has too many fields")
    parsed: dict = {}
    allowed = {"FREQ", "INTERVAL", "COUNT", "UNTIL", "BYDAY", "BYMONTHDAY", "BYMONTH"}
    for chunk in chunks:
        if "=" not in chunk:
            raise ValueError("RRULE field has no value")
        key, value = chunk.split("=", 1)
        key, value = key.upper(), value.upper()
        if key not in allowed or not value or key in parsed:
            raise ValueError(f"unsupported, empty or duplicate RRULE field: {key}")
        parsed[key] = value

    freq = parsed.get("FREQ")
    if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        raise ValueError("unsupported or missing RRULE FREQ")

    def positive(name: str, maximum: int, default: int | None = None) -> int | None:
        value = parsed.get(name)
        if value is None:
            return default
        try:
            number = int(value)
        except (TypeError, ValueError):
            raise ValueError(f"RRULE {name} is not an integer")
        if number <= 0 or number > maximum:
            raise ValueError(f"RRULE {name} is outside 1..{maximum}")
        return number

    def integer_list(name: str, minimum: int, maximum: int, *, reject_zero=False) -> list[int]:
        value = parsed.get(name)
        if value is None:
            return []
        tokens = value.split(",")
        if not tokens or len(tokens) > MAX_RULE_TOKENS:
            raise ValueError(f"RRULE {name} has too many values")
        result: list[int] = []
        for token in tokens:
            try:
                number = int(token)
            except ValueError:
                raise ValueError(f"RRULE {name} contains a non-integer")
            if number < minimum or number > maximum or (reject_zero and number == 0):
                raise ValueError(f"RRULE {name} contains an out-of-range value")
            result.append(number)
        return result

    parsed["_INTERVAL"] = positive("INTERVAL", MAX_RRULE_INTERVAL, 1)
    parsed["_COUNT"] = positive("COUNT", MAX_RRULE_COUNT)
    if parsed.get("COUNT") and parsed.get("UNTIL"):
        raise ValueError("RRULE cannot contain both COUNT and UNTIL")
    parsed["_BYMONTH"] = integer_list("BYMONTH", 1, 12)
    parsed["_BYMONTHDAY"] = integer_list("BYMONTHDAY", -31, 31, reject_zero=True)

    bydays: list[tuple[int | None, str]] = []
    if parsed.get("BYDAY"):
        tokens = parsed["BYDAY"].split(",")
        if len(tokens) > MAX_RULE_TOKENS:
            raise ValueError("RRULE BYDAY has too many values")
        for token in tokens:
            match = re.fullmatch(r"([+-]?\d+)?(MO|TU|WE|TH|FR|SA|SU)", token)
            if not match:
                raise ValueError("RRULE BYDAY contains an invalid value")
            ordinal_text, weekday = match.groups()
            ordinal = int(ordinal_text) if ordinal_text else None
            if ordinal is not None:
                if ordinal == 0 or abs(ordinal) > 53 or freq in ("DAILY", "WEEKLY"):
                    raise ValueError("RRULE BYDAY ordinal is invalid for this frequency")
            bydays.append((ordinal, weekday))
    parsed["_BYDAY"] = bydays
    return parsed


def byday_matches(
    day: date, tokens: list[tuple[int | None, str]], freq: str, bymonth: bool = False
) -> bool:
    # `same` depends only on day.year/day.month/day.weekday(), which are fixed
    # for the whole call — not on which token is being checked. Building it
    # once here rather than per matching token is what keeps a rule with
    # hundreds of BYDAY tokens (all landing on the same weekday) from redoing
    # an O(366) scan that many times for a single day.
    same_cache: list | None = None

    for ordinal, name in tokens:
        if day.weekday() != WEEKDAYS[name]:
            continue
        if ordinal is None:
            return True
        position = ordinal

        if same_cache is None:
            if freq == "MONTHLY" or (freq == "YEARLY" and bymonth):
                days_in_month = _calendar.monthrange(day.year, day.month)[1]
                same_cache = [
                    d for d in range(1, days_in_month + 1)
                    if date(day.year, day.month, d).weekday() == day.weekday()
                ]
            else:  # YEARLY
                same_cache = []
                for month in range(1, 13):
                    for d in range(1, _calendar.monthrange(day.year, month)[1] + 1):
                        candidate = date(day.year, month, d)
                        if candidate.weekday() == day.weekday():
                            same_cache.append(candidate)

        needle = day.day if freq == "MONTHLY" or (freq == "YEARLY" and bymonth) else day
        index = same_cache.index(needle) + 1
        if position > 0 and index == position:
            return True
        if position < 0 and index == len(same_cache) + position + 1:
            return True
    return False


def day_matches(day: date, rule: dict, seed: date) -> bool:
    freq = rule.get("FREQ", "")
    interval = rule["_INTERVAL"]

    months = rule["_BYMONTH"]
    if months and day.month not in months:
        return False

    monthdays = rule["_BYMONTHDAY"]
    if monthdays:
        days_in_month = _calendar.monthrange(day.year, day.month)[1]
        wanted = {d if d > 0 else days_in_month + d + 1 for d in monthdays}
        if day.day not in wanted:
            return False

    bydays = rule["_BYDAY"]

    if freq == "DAILY":
        if (day - seed).days % interval:
            return False
        return byday_matches(day, bydays, freq) if bydays else True

    if freq == "WEEKLY":
        seed_week = seed - timedelta(days=seed.weekday())
        day_week = day - timedelta(days=day.weekday())
        if ((day_week - seed_week).days // 7) % interval:
            return False
        if bydays:
            return byday_matches(day, bydays, freq)
        return day.weekday() == seed.weekday()

    if freq == "MONTHLY":
        months_apart = (day.year - seed.year) * 12 + (day.month - seed.month)
        if months_apart % interval:
            return False
        if bydays:
            return byday_matches(day, bydays, freq)
        if monthdays:
            return True
        return day.day == seed.day

    if freq == "YEARLY":
        if (day.year - seed.year) % interval:
            return False
        if bydays:
            return byday_matches(day, bydays, freq, bool(months))
        if monthdays:
            return True
        if months:
            return day.day == seed.day
        return (day.month, day.day) == (seed.month, seed.day)

    return False


def _months_between(seed: date, months_ahead: int) -> tuple[int, int]:
    total = seed.month - 1 + months_ahead
    return seed.year + total // 12, total % 12 + 1


def _weekly_occurrences_before(
    seed_date: date,
    interval: int,
    bydays: list[tuple[int | None, str]],
    exclusive: date,
) -> int:
    """Count a plain weekly rule before a date without walking every day.

    Weekly BYDAY ordinals are rejected by parse_rrule(), so each selected
    weekday forms one arithmetic sequence separated by interval weeks.
    """
    if exclusive <= seed_date:
        return 0
    weekdays = {WEEKDAYS[name] for ordinal, name in bydays if ordinal is None}
    if not weekdays:
        weekdays = {seed_date.weekday()}
    seed_week = seed_date - timedelta(days=seed_date.weekday())
    stride_days = 7 * interval
    total = 0
    for weekday in weekdays:
        first = seed_week + timedelta(days=weekday)
        if first < seed_date:
            first += timedelta(days=stride_days)
        if first < exclusive:
            total += ((exclusive - timedelta(days=1) - first).days // stride_days) + 1
    return total


def _fast_forward_count_anchor(
    seed_date: date, freq: str, interval: int, before_date: date
) -> tuple[date, int]:
    """For a COUNT-anchored walk with no BYDAY/BYMONTHDAY/BYMONTH — the
    common shape of a plain "every N days/weeks/months/years" series — jump
    straight to the last occurrence at or before before_date, in time
    proportional to the number of *strides*, not the number of days between
    them. This is what keeps an old-but-simple COUNT=500 weekly meeting
    cheap without needing a huge MAX_EXPAND_STEPS to still find it: a decade
    is ~3,650 days but only ~520 weekly strides, and the caller's ordinary
    day-by-day loop still does the actual matching from the returned cursor
    — this only picks where to start it, it never bypasses day_matches."""
    if before_date <= seed_date:
        return seed_date, 0

    if freq == "DAILY":
        k = (before_date - seed_date).days // interval
        return seed_date + timedelta(days=k * interval), k

    if freq == "WEEKLY":
        k = ((before_date - seed_date).days // 7) // interval
        return seed_date + timedelta(weeks=k * interval), k

    if freq == "MONTHLY":
        cursor, seen = seed_date, 0
        k = 0
        while True:
            year, month = _months_between(seed_date, k * interval)
            if year > before_date.year + 1:  # can't possibly still be <= before_date
                break
            days_in_month = _calendar.monthrange(year, month)[1]
            if seed_date.day <= days_in_month:
                candidate = date(year, month, seed_date.day)
                if candidate > before_date:
                    break
                cursor, seen = candidate, seen + 1
            k += 1
        return cursor, max(0, seen - 1)

    if freq == "YEARLY":
        cursor, seen = seed_date, 0
        k = 0
        while True:
            year = seed_date.year + k * interval
            if year > before_date.year + 1:
                break
            try:
                candidate = date(year, seed_date.month, seed_date.day)
            except ValueError:
                k += 1
                continue
            if candidate > before_date:
                break
            cursor, seen = candidate, seen + 1
            k += 1
        return cursor, max(0, seen - 1)

    return seed_date, 0


def expand(event: dict, window_start: datetime, window_end: datetime) -> list[datetime]:
    """Occurrence start times inside the window."""
    start = event["start"]
    is_date = isinstance(start, date) and not isinstance(start, datetime)
    seed_date = start if is_date else start.date()
    seed_time = None if is_date else start.timetz()

    def materialize(day: date) -> datetime:
        if is_date:
            return datetime.combine(day, dtime(0, 0), tzinfo=local_zone())
        return datetime.combine(day, seed_time)

    if not event["rrule"]:
        occurrence = materialize(seed_date)
        return [occurrence] if window_start <= occurrence <= window_end else []

    rule = parse_rrule(event["rrule"])
    count = rule["_COUNT"]
    until = None
    if rule.get("UNTIL"):
        parsed_until, _ = parse_dt(rule["UNTIL"], {})
        if isinstance(parsed_until, datetime):
            until = parsed_until
        elif isinstance(parsed_until, date):
            until = datetime.combine(parsed_until, dtime(23, 59, 59), tzinfo=local_zone())
        else:
            raise ValueError("RRULE UNTIL is invalid")

    excluded = set()
    for item in event["exdates"][:MAX_EXDATES_PER_EVENT]:
        excluded.add(item if isinstance(item, date) and not isinstance(item, datetime) else item.date())

    # COUNT is relative to the first occurrence, so it forces a walk from the
    # seed — day by day, that is O(days since DTSTART), which is fine for a
    # hostile rule (that's exactly what the caps below are for) but was also
    # quietly punishing a completely ordinary "repeat weekly, 500 times"
    # meeting from years ago. `_fast_forward_count_anchor` closes that gap
    # arithmetically for the common shapes (no BYDAY/BYMONTHDAY/BYMONTH);
    # everything else still walks, but now from a well-bounded starting
    # point rather than from a possibly decades-old seed. `count is not
    # None` throughout on purpose: zero and malformed values were already
    # rejected by parse_rrule(), so no invalid COUNT can become unbounded.
    freq = rule.get("FREQ", "")
    interval = rule["_INTERVAL"]
    simple_shape = (
        freq in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY")
        and not rule["_BYDAY"] and not rule["_BYMONTHDAY"] and not rule["_BYMONTH"]
    )

    before = window_start.date() - timedelta(days=1)
    weekly_shape = (
        freq == "WEEKLY" and not rule["_BYMONTHDAY"] and not rule["_BYMONTH"]
    )
    if count is not None and weekly_shape:
        cursor = max(seed_date, before)
        seen = _weekly_occurrences_before(
            seed_date, interval, rule["_BYDAY"], cursor
        )
        if seen >= count:
            return []
    elif count is not None and simple_shape:
        cursor, seen = _fast_forward_count_anchor(seed_date, freq, interval, before)
        if seen >= count:
            return []
    else:
        cursor = seed_date if count is not None else max(seed_date, window_start.date() - timedelta(days=1))
        seen = 0

    last_day = window_end.date()
    found: list[datetime] = []
    steps = 0
    step_deadline = time.monotonic() + MAX_EXPAND_SECONDS

    while cursor <= last_day:
        steps += 1
        if steps > MAX_EXPAND_STEPS:
            break
        # Step count alone is not trusted to bound cost — see byday_matches's
        # per-day cache, which is what makes that assumption true today, and
        # this the backstop for if it stops being true tomorrow. Checked
        # periodically rather than every step so the clock call itself stays
        # cheap.
        if steps % 256 == 0 and time.monotonic() > step_deadline:
            break
        try:
            matched = day_matches(cursor, rule, seed_date)
        except Exception:
            break
        if matched and cursor >= seed_date:
            seen += 1
            if count is not None and seen > count:
                break
            occurrence = materialize(cursor)
            if until and occurrence > until:
                break
            if cursor not in excluded and window_start <= occurrence <= window_end:
                found.append(occurrence)
        cursor += timedelta(days=1)

    return found


# --------------------------------------------------------------------------
# meeting links


LINK_PATTERNS = [
    r"https://[a-z0-9.-]*meet\.google\.com/[^\s<>\"']+",
    r"https://[a-z0-9.-]*zoom\.us/j/[^\s<>\"']+",
    r"https://[a-z0-9.-]*zoom\.us/my/[^\s<>\"']+",
    r"https://teams\.microsoft\.com/l/meetup-join/[^\s<>\"']+",
    r"https://teams\.live\.com/meet/[^\s<>\"']+",
    r"https://[a-z0-9.-]*webex\.com/[^\s<>\"']+",
    r"https://[a-z0-9.-]*whereby\.com/[^\s<>\"']+",
    r"https://meet\.jit\.si/[^\s<>\"']+",
    r"https://[a-z0-9.-]*around\.co/[^\s<>\"']+",
    r"https://app\.gather\.town/[^\s<>\"']+",
    r"https://[a-z0-9.-]*slack\.com/[^\s<>\"']*huddle[^\s<>\"']*",
]


def find_link(event: dict) -> str:
    haystacks = [
        event.get("conference", ""),
        event.get("location", ""),
        event.get("url", ""),
        event.get("description", ""),
    ]
    for pattern in LINK_PATTERNS:
        for text in haystacks:
            if not text:
                continue
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                return match.group(0).rstrip(".,);")
    for text in haystacks:
        match = re.search(r"https://[^\s<>\"']+", text or "")
        if match:
            return match.group(0).rstrip(".,);")
    return ""


# --------------------------------------------------------------------------
# collection


def collect(cfg: dict, force_refresh: bool = False) -> tuple[list[dict], list[str]]:
    sources = cfg.get("calendars") or []
    warnings: list[str] = []
    events: list[dict] = []
    overrides: dict[tuple[str, str], dict] = {}
    total_documents = 0
    total_bytes = 0
    # Shared across every remote source in this one call, so N slow calendars
    # cost roughly the same as one, not N times as much — see fetch_remote.
    deadline = time.monotonic() + FETCH_TOTAL_DEADLINE

    for source in sources:
        documents, source_warnings = read_source(
            str(source), int(cfg.get("refreshSeconds", 300)), force_refresh, deadline
        )
        warnings.extend(source_warnings)
        label = Path(str(source)).name if not is_remote(str(source)) else "remote"
        for document in documents:
            document_bytes = len(document.encode("utf-8"))
            if total_documents >= MAX_TOTAL_DOCUMENTS:
                warnings.append(
                    f"stopped after {MAX_TOTAL_DOCUMENTS} calendar documents; the rest were ignored"
                )
                return events, warnings[:MAX_WARNINGS]
            if total_bytes + document_bytes > MAX_TOTAL_ICS_BYTES:
                warnings.append(
                    f"stopped after the {MAX_TOTAL_ICS_BYTES}-byte aggregate calendar budget"
                )
                return events, warnings[:MAX_WARNINGS]
            total_documents += 1
            total_bytes += document_bytes
            parsed_events, truncated = split_events(document)
            if truncated:
                warnings.append(
                    f"{label}: more than {MAX_EVENTS_PER_DOCUMENT} events in one document, "
                    "the rest were ignored"
                )
            for lines in parsed_events:
                if len(events) >= MAX_TOTAL_EVENTS:
                    warnings.append(
                        f"stopped after {MAX_TOTAL_EVENTS} total events; the rest were ignored"
                    )
                    return events, warnings[:MAX_WARNINGS]
                try:
                    event = parse_event(lines, label)
                except Exception:
                    continue
                if event is None:
                    continue
                if event["recurrence_id"] is not None:
                    key = (event["uid"], str(event["recurrence_id"]))
                    overrides[key] = event
                events.append(event)

    return events, warnings[:MAX_WARNINGS]


class _RegexTimedOut(Exception):
    pass


def _safe_regex_search(pattern: str, text: str) -> bool:
    try:
        compiled = re.compile(pattern, re.IGNORECASE)
    except re.error:
        return False
    # Do not truncate before matching. Truncation changes regex semantics at
    # the artificial end of the string: for example, ``(a+)+$`` incorrectly
    # matches the truncated prefix of ``a * limit + !``. Parsed calendar
    # fields are already capped at this limit; reject an oversized value here
    # as a defence-in-depth measure instead of manufacturing a false match.
    if len(text) > MAX_REGEX_INPUT_CHARS:
        return False
    bounded_text = text
    if not hasattr(signal, "setitimer"):
        # Omarchy is Linux and always takes the timed path. This fallback keeps
        # diagnostics usable on platforms that lack POSIX interval timers.
        return compiled.search(bounded_text) is not None

    def timed_out(signum, frame):
        raise _RegexTimedOut()

    previous_handler = signal.signal(signal.SIGALRM, timed_out)
    previous_timer = signal.setitimer(signal.ITIMER_REAL, MAX_REGEX_SECONDS)
    try:
        return compiled.search(bounded_text) is not None
    except _RegexTimedOut:
        return False
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if previous_timer[0] > 0:
            signal.setitimer(signal.ITIMER_REAL, *previous_timer)


def wanted(event: dict, cfg: dict) -> bool:
    if cfg.get("skipCancelled", True) and event.get("status") == "CANCELLED":
        return False
    if cfg.get("ignoreAllDay", True) and event.get("all_day"):
        return False
    if cfg.get("skipDeclined", True):
        mine = {str(a).lower() for a in cfg.get("selfEmails", [])}
        declined = {
            address.replace("mailto:", "") for address in event.get("declined_addresses", [])
        }
        if mine and (mine & declined):
            return False
    for pattern in cfg.get("ignoreTitles", []):
        if _safe_regex_search(pattern, event.get("summary", "")):
            return False
    return True


def occurrences(cfg: dict, now: datetime, horizon: timedelta, force_refresh: bool = False):
    events, warnings = collect(cfg, force_refresh)
    window_start = now - timedelta(minutes=5)
    window_end = now + horizon

    overridden: set[tuple[str, str]] = set()
    for event in events:
        if event["recurrence_id"] is not None:
            overridden.add((event["uid"], str(event["recurrence_id"])))

    out = []
    out_bytes = 2  # JSON list brackets
    # Each event's own walk is bounded (see expand()'s MAX_EXPAND_SECONDS),
    # but many maximally-expensive events must not be able to add those
    # bounds up into minutes — this is the budget for the whole batch.
    expand_deadline = time.monotonic() + MAX_TOTAL_EXPAND_SECONDS
    truncated = False
    for event in events:
        if time.monotonic() > expand_deadline:
            truncated = True
            break
        if not wanted(event, cfg):
            continue
        try:
            event_starts = expand(event, window_start, window_end)
        except Exception:
            # A malformed recurrence rule costs this one event, not the rest
            # of the agenda.
            continue
        for start in event_starts:
            if len(out) >= MAX_OCCURRENCES:
                warnings.append(
                    f"stopped after {MAX_OCCURRENCES} occurrences; the rest were ignored"
                )
                out.sort(key=lambda item: item["start"])
                return out, warnings[:MAX_WARNINGS]
            if event["recurrence_id"] is None and (event["uid"], str(start)) in overridden:
                continue
            length = event["end"] - event["start"] if not event["all_day"] else timedelta(days=1)
            link = find_link(event)
            if cfg.get("onlyWithLink") and not link:
                continue
            item = {
                "uid": event["uid"][:MAX_UID_CHARS],
                "occurrenceId": f"{event['uid']}@{int(start.timestamp())}"[:768],
                "summary": (event["summary"] or "(no title)")[:MAX_FIELD_CHARS],
                "location": event["location"][:MAX_FIELD_CHARS],
                "link": link[:MAX_LINK_CHARS],
                "calendar": event["calendar"][:MAX_SOURCE_CHARS],
                "allDay": event["all_day"],
                "start": int(start.timestamp()),
                "end": int((start + length).timestamp()),
                "startsIn": int((start - now).total_seconds()),
            }
            item_bytes = len(
                json.dumps(item, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
            ) + 1
            if out_bytes + item_bytes > MAX_OCCURRENCE_PAYLOAD_BYTES:
                warnings.append(
                    f"stopped after the {MAX_OCCURRENCE_PAYLOAD_BYTES}-byte occurrence budget"
                )
                out.sort(key=lambda entry: entry["start"])
                return out, warnings[:MAX_WARNINGS]
            out.append(item)
            out_bytes += item_bytes

    if truncated:
        warnings.append(
            f"stopped expanding recurring events after {MAX_TOTAL_EXPAND_SECONDS}s; "
            "some events may be missing"
        )

    out.sort(key=lambda item: item["start"])
    return out, warnings[:MAX_WARNINGS]


# --------------------------------------------------------------------------
# writing the configuration


def write_config(path: Path, data: dict) -> None:
    # The file holds secret calendar addresses; write_private keeps it
    # owner-only and atomic.
    serialized = json.dumps(data, indent=2, ensure_ascii=False) + "\n"
    if len(serialized.encode("utf-8")) > MAX_CONFIG_BYTES:
        raise SystemExit(f"mokuzen: configuration exceeds {MAX_CONFIG_BYTES} bytes")
    write_private(path, serialized)


def _count_documents_bounded(
    documents: list[str], budget: dict[str, int]
) -> tuple[int, str | None]:
    """Count events while sharing the same aggregate caps as collect()."""
    count = 0
    for document in documents:
        if budget["documents"] >= MAX_TOTAL_DOCUMENTS:
            return count, f"stopped after {MAX_TOTAL_DOCUMENTS} calendar documents"
        if budget["events"] >= MAX_TOTAL_EVENTS:
            return count, f"stopped after {MAX_TOTAL_EVENTS} total events"
        document_bytes = len(document.encode("utf-8"))
        if budget["bytes"] + document_bytes > MAX_TOTAL_ICS_BYTES:
            return count, f"stopped after the {MAX_TOTAL_ICS_BYTES}-byte calendar budget"
        budget["documents"] += 1
        budget["bytes"] += document_bytes
        parsed_count = len(split_events(document)[0])
        remaining = MAX_TOTAL_EVENTS - budget["events"]
        accepted = min(parsed_count, remaining)
        count += accepted
        budget["events"] += accepted
        if parsed_count > remaining:
            return count, f"stopped after {MAX_TOTAL_EVENTS} total events"
    return count, None


def cmd_setup(args) -> int:
    path = config_path(args.config)
    data: dict = {}
    if path.exists():
        try:
            loaded = json.loads(_read_capped_no_follow(path, MAX_CONFIG_BYTES))
        except json.JSONDecodeError:
            raise SystemExit(f"mokuzen: {path} is not valid JSON; fix or delete it first")
        except OSError as exc:
            raise SystemExit(f"mokuzen: cannot read {path}: {exc}")
        if not isinstance(loaded, dict):
            raise SystemExit(f"mokuzen: {path} must contain a JSON object")
        try:
            data = _validate_config(loaded, path)
        except ValueError as exc:
            raise SystemExit(f"mokuzen: invalid configuration in {path}: {exc}")
        data.pop("_path", None)
        data.pop("_exists", None)

    calendars = data.get("calendars")
    if isinstance(calendars, str):
        calendars = [calendars]
    if not isinstance(calendars, list):
        calendars = []

    changed = False

    for source in args.calendar or []:
        if source in calendars:
            print(f"already configured: {mask(source)}")
            continue
        calendars.append(source)
        changed = True
        print(f"added: {mask(source)}")

    for source in args.remove_calendar or []:
        if source in calendars:
            calendars.remove(source)
            changed = True
            print(f"removed: {mask(source)}")
        else:
            print(f"not configured, nothing to remove: {mask(source)}")

    if changed or "calendars" not in data:
        data["calendars"] = calendars

    for key, value in (
        ("leadSeconds", args.lead),
        ("pollSeconds", args.poll),
        ("snoozeSeconds", args.snooze),
    ):
        if value is not None:
            data[key] = value
            changed = True
            print(f"set {key} = {value}")

    try:
        normalized = _validate_config(data, path)
    except ValueError as exc:
        raise SystemExit(f"mokuzen: invalid configuration: {exc}")
    normalized.pop("_path", None)
    normalized.pop("_exists", None)
    data = normalized
    calendars = data["calendars"]

    if args.show or not changed:
        shown = dict(data)
        shown["calendars"] = [mask(str(c)) for c in calendars]
        print(f"\n{path}")
        print(json.dumps(shown, indent=2, ensure_ascii=False))
        if not changed:
            return 0

    write_config(path, data)
    print(f"\nwrote {path} (owner-only)")

    if args.no_verify:
        return 0

    # A secret address that 404s is the failure people actually hit, and they
    # hit it silently. Say so now rather than at 9:59am. One shared deadline
    # across every calendar being verified, so a long list of them can't add
    # up to an unbounded run - see collect()'s use of the same pattern.
    problems = 0
    verify_deadline = time.monotonic() + SETUP_VERIFY_DEADLINE
    verify_budget = {"documents": 0, "bytes": 0, "events": 0}
    for source in calendars:
        documents, warnings = read_source(str(source), 0, force=True, shared_deadline=verify_deadline)
        count, budget_warning = _count_documents_bounded(documents, verify_budget)
        if budget_warning:
            warnings.append(budget_warning)
        if warnings or not documents:
            problems += 1
            print(f"  ✗ {warnings[0] if warnings else mask(str(source)) + ': nothing readable'}")
        else:
            print(f"  ✓ {mask(str(source))}: {count} events")
        if budget_warning:
            break
    return 1 if problems else 0


# --------------------------------------------------------------------------
# the poll cache


OCCURRENCE_HORIZON = timedelta(hours=24)


def occurrence_cache_path() -> Path:
    return cache_dir() / "occurrences.json"


def config_fingerprint(cfg: dict) -> str:
    relevant = {
        key: cfg.get(key)
        for key in (
            "calendars", "ignoreAllDay", "skipCancelled", "skipDeclined",
            "selfEmails", "ignoreTitles", "onlyWithLink",
        )
    }
    blob = json.dumps(relevant, sort_keys=True, default=str)
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()[:16]


def _validated_cached_occurrences(payload: dict) -> tuple[list[dict], list[str]]:
    """Return a small, typed projection of the owner-only occurrence cache.

    The cache is still parsed as untrusted input: a same-user process or a
    damaged sync can replace it, and its contents must not become an
    unbounded QML model just because the byte cap happened to accept it.
    """
    raw_events = payload.get("events")
    raw_warnings = payload.get("warnings")
    if not isinstance(raw_events, list) or len(raw_events) > MAX_OCCURRENCES:
        raise ValueError("invalid occurrence cache cardinality")
    if not isinstance(raw_warnings, list) or len(raw_warnings) > MAX_WARNINGS:
        raise ValueError("invalid occurrence warning cardinality")

    string_limits = {
        "uid": MAX_UID_CHARS,
        "occurrenceId": 768,
        "summary": MAX_FIELD_CHARS,
        "location": MAX_FIELD_CHARS,
        "link": MAX_LINK_CHARS,
        "calendar": MAX_SOURCE_CHARS,
    }
    events: list[dict] = []
    for raw in raw_events:
        if not isinstance(raw, dict):
            raise ValueError("invalid occurrence cache event")
        item: dict = {}
        for key, limit in string_limits.items():
            value = raw.get(key)
            if not isinstance(value, str) or len(value) > limit:
                raise ValueError(f"invalid cached occurrence {key}")
            item[key] = value
        if not isinstance(raw.get("allDay"), bool):
            raise ValueError("invalid cached occurrence allDay")
        item["allDay"] = raw["allDay"]
        for key in ("start", "end", "startsIn"):
            value = raw.get(key)
            if isinstance(value, bool) or not isinstance(value, int) or abs(value) > 10**12:
                raise ValueError(f"invalid cached occurrence {key}")
            item[key] = value
        events.append(item)

    warnings: list[str] = []
    for warning in raw_warnings:
        if not isinstance(warning, str) or len(warning) > MAX_WARNING_CHARS:
            raise ValueError("invalid cached occurrence warning")
        warnings.append(warning)
    return events, warnings


def cached_occurrences(cfg: dict, now: datetime, force: bool = False):
    """Expanding a real calendar costs the best part of a second — a 6 MB
    export with ten thousand events is not unusual. The poll that asks "is
    anything due right now" runs every 30s and must not pay that. So the
    expansion happens on the refresh cadence and lands in a small file the
    poll can read; only the countdown is recomputed against the clock.

    The fingerprint covers every setting that changes which events matter, so
    editing the configuration takes effect on the next poll rather than
    whenever the cache happens to expire.
    """
    path = occurrence_cache_path()
    fingerprint = config_fingerprint(cfg)
    max_age = max(30, int(cfg.get("refreshSeconds", 300)))

    if not force:
        try:
            cached = json.loads(_read_capped_no_follow(path, MAX_CACHE_BYTES))
            if not isinstance(cached, dict):
                raise ValueError("occurrence cache must be an object")
            usable = (
                cached.get("fingerprint") == fingerprint
                and now.timestamp() - float(cached.get("computed", 0)) < max_age
                # Never serve a horizon that is about to run out from under us.
                and float(cached.get("horizonEnd", 0)) > now.timestamp() + 3600
            )
            if usable:
                events, warnings = _validated_cached_occurrences(cached)
                return events, warnings, True
        except (OSError, ValueError, TypeError):
            pass

    items, warnings = occurrences(cfg, now, OCCURRENCE_HORIZON, force_refresh=force)
    payload = {
        "fingerprint": fingerprint,
        "computed": int(now.timestamp()),
        "horizonEnd": int((now + OCCURRENCE_HORIZON).timestamp()),
        "events": items,
        "warnings": warnings,
    }
    serialized = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
    try:
        if len(serialized.encode("utf-8")) <= MAX_CACHE_BYTES:
            write_private(path, serialized)
    except OSError:
        pass
    return items, warnings, False


# --------------------------------------------------------------------------
# commands


def cmd_config(args) -> int:
    """Emit only the validated, bounded fields consumed by Service.qml."""
    cfg = load_config(args.config)
    json.dump({key: cfg[key] for key in DEFAULTS}, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def cmd_check(args) -> int:
    cfg = load_config(args.config)
    now = datetime.now(timezone.utc).astimezone()
    lead = args.window if args.window is not None else int(cfg.get("leadSeconds", 60))
    lead = max(0, min(86_400, lead))
    items, warnings, from_cache = cached_occurrences(cfg, now)

    upcoming = []
    for item in items:
        starts_in = int(float(item["start"]) - now.timestamp())
        if -60 <= starts_in <= lead:
            fresh = dict(item)
            fresh["startsIn"] = starts_in
            upcoming.append(fresh)
    upcoming.sort(key=lambda entry: entry["start"])

    payload = {
        "now": int(now.timestamp()),
        "leadSeconds": lead,
        "cached": from_cache,
        "event": upcoming[0] if upcoming else None,
        "warnings": warnings,
    }
    json.dump(payload, sys.stdout, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def cmd_list(args) -> int:
    cfg = load_config(args.config)
    now = datetime.now(timezone.utc).astimezone()
    days = max(1, min(366, args.days))
    limit = max(1, min(500, args.limit))
    items, warnings = occurrences(cfg, now, timedelta(days=days))
    json.dump(
        {"events": items[:limit], "warnings": warnings},
        sys.stdout,
        indent=2,
        ensure_ascii=False,
    )
    sys.stdout.write("\n")
    return 0


def cmd_refresh(args) -> int:
    cfg = load_config(args.config)
    now = datetime.now(timezone.utc).astimezone()
    items, warnings, _ = cached_occurrences(cfg, now, force=True)
    json.dump(
        {
            "refreshed": len(cfg.get("calendars", [])),
            "upcoming": len(items),
            "warnings": warnings,
        },
        sys.stdout,
        ensure_ascii=False,
    )
    sys.stdout.write("\n")
    return 1 if warnings else 0


def cmd_doctor(args) -> int:
    cfg = load_config(args.config)
    now = datetime.now(timezone.utc).astimezone()
    report = {
        "config": cfg["_path"],
        "configExists": cfg["_exists"],
        "cacheDir": str(cache_dir()),
        "calendars": [],
        "warnings": [],
    }
    doctor_deadline = time.monotonic() + FETCH_TOTAL_DEADLINE
    doctor_budget = {"documents": 0, "bytes": 0, "events": 0}
    for source in cfg.get("calendars", []):
        documents, warnings = read_source(
            str(source), int(cfg.get("refreshSeconds", 300)), shared_deadline=doctor_deadline
        )
        count, budget_warning = _count_documents_bounded(documents, doctor_budget)
        if budget_warning:
            warnings.append(budget_warning)
        report["calendars"].append(
            {
                "source": ("<remote>" if is_remote(str(source)) else str(source)),
                "remote": is_remote(str(source)),
                "documents": len(documents),
                "events": count,
                "ok": bool(documents) and not warnings,
            }
        )
        report["warnings"].extend(warnings)
        if budget_warning:
            break
    items, more = occurrences(cfg, now, timedelta(days=7))
    report["warnings"].extend(more)
    report["warnings"] = report["warnings"][:MAX_WARNINGS]
    report["next7Days"] = len(items)
    report["nextUp"] = items[0] if items else None
    json.dump(report, sys.stdout, indent=2, ensure_ascii=False)
    sys.stdout.write("\n")
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["_fetch-worker"]:
        return _fetch_worker_main(argv[1:])

    # Make this process its own process-group leader, so whoever launched us
    # (Service.qml's Process) can reliably reach the whole group with one
    # `kill -SIGNAL -PID`, including any child this script might ever spawn —
    # without depending on an external wrapper like `setsid`, whose fork-or-
    # not behavior depends on the process group of whoever launched *it*.
    # Skipped when stdin is a terminal: that means a person is running
    # `bin/mokuzen-agenda check` by hand (the README's own diagnostic
    # workflow), and moving to a new process group would detach it from the
    # terminal's job control, breaking Ctrl-C — a protection this script
    # only needs when something else (Quickshell, whose subprocess has no
    # pty) is holding the leash.
    try:
        if os.environ.get("MOKUZEN_FETCH_WORKER") != "1" and not sys.stdin.isatty():
            os.setpgid(0, 0)
    except (OSError, AttributeError, ValueError):
        # OSError: setpgid itself refused. AttributeError/ValueError: stdin
        # is None or already closed — isatty() itself can raise, not just
        # setpgid, and either way there is nothing safer to do than skip it.
        pass

    parser = argparse.ArgumentParser(prog="mokuzen-agenda", description=__doc__)
    parser.add_argument("--config", help="path to mokuzen.json")
    sub = parser.add_subparsers(dest="command", required=True)

    config = sub.add_parser("config", help=argparse.SUPPRESS)
    config.set_defaults(func=cmd_config)

    check = sub.add_parser("check", help="print the next occurrence inside the lead window")
    check.add_argument("--window", type=int, help="lead window in seconds (overrides config)")
    check.set_defaults(func=cmd_check)

    listing = sub.add_parser("list", help="print upcoming occurrences")
    listing.add_argument("--days", type=int, default=7)
    listing.add_argument("--limit", type=int, default=50)
    listing.set_defaults(func=cmd_list)

    refresh = sub.add_parser("refresh", help="refetch remote calendars")
    refresh.set_defaults(func=cmd_refresh)

    doctor = sub.add_parser("doctor", help="report configuration health")
    doctor.set_defaults(func=cmd_doctor)

    setup = sub.add_parser("setup", help="write the configuration file")
    setup.add_argument(
        "--calendar", action="append", metavar="URL_OR_PATH",
        help="add a calendar: a secret iCal address, an .ics file, or a directory. Repeatable.",
    )
    setup.add_argument(
        "--remove-calendar", action="append", metavar="URL_OR_PATH",
        help="remove a calendar previously added. Repeatable.",
    )
    setup.add_argument("--lead", type=int, metavar="SECONDS", help="how long before the start the alert appears")
    setup.add_argument("--poll", type=int, metavar="SECONDS", help="how often the agenda is consulted")
    setup.add_argument("--snooze", type=int, metavar="SECONDS", help="how long the snooze key hides an alert")
    setup.add_argument("--show", action="store_true", help="print the resulting configuration, secrets masked")
    setup.add_argument("--no-verify", action="store_true", help="skip fetching the calendars afterwards")
    setup.set_defaults(func=cmd_setup)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
